{# {% extends "index.njk" %} {% block content %}

<div id="container"></div>

<script type="module">
  import { renderDropdownMenu } from '/js/renders/renderItems.js';

  // Función para obtener las rutas desde la API
  async function fetchRoutes() {
    try {
      const response = await fetch('/api/routes');
      const data = await response.json();

      // Verifica que 'data.routes' sea un array
      if (Array.isArray(data.routes)) {
        renderDropdownMenu(data.routes); // Pasa el array de rutas
      } else {
        console.error(
          '❌ La respuesta no contiene un array en "routes":',
          data
        );
      }
    } catch (error) {
      console.error('❌ Error al cargar rutas desde la API:', error);
    }
  }

  // Función para renderizar el menú desplegable

  // Llamamos a la función para cargar las rutas al cargar la página
  fetchRoutes();
</script>

{% endblock %} #} {% extends "index.njk" %} {% block content %}
<div id="container">
  <button id="open-main-modal">🧪 Abrir Modal Principal</button>
</div>

<script>
  let modalCounter = 0; // Contador de modales para manejar el z-index
  let openModals = []; // Pila para rastrear los modales abiertos

  function renderModal({
    title = 'Modal',
    message = '¿Estás seguro?',
    icon = '',
    confirmText = 'Confirmar',
    cancelText = 'Cancelar',
    onConfirm = null,
    onOpenNextModal = null,
    isFullscreen = false,
    pageId = '', // Identificador único de la página
    modalNumber = 1, // Número del modal que se está abriendo
    parentModalId = null, // ID del modal padre, si tiene
  }) {
    modalCounter++; // Incrementamos el contador para manejar el z-index

    const modalId = `modal-${Date.now()}-${modalCounter}`; // Un ID único para el modal

    // Estructura del modal
    const overlay = document.createElement('div');
    overlay.style.position = 'fixed';
    overlay.style.top = 0;
    overlay.style.left = 0;
    overlay.style.width = '100%';
    overlay.style.height = '100%';
    overlay.style.backgroundColor = 'rgba(0, 0, 0, 0.5)';
    overlay.style.display = 'flex';
    overlay.style.alignItems = 'center';
    overlay.style.justifyContent = 'center';
    overlay.style.zIndex = 9999 + modalCounter; // Asignamos un z-index único

    const modal = document.createElement('div');
    modal.style.backgroundColor = '#fff';
    modal.style.padding = '20px';
    modal.style.borderRadius = '10px';
    modal.style.boxShadow = '0 0 10px rgba(0,0,0,0.3)';
    modal.style.position = 'relative';

    // Si es fullscreen, modificar el tamaño
    if (isFullscreen) {
      modal.style.width = '100vw';
      modal.style.height = '100vh';
      modal.style.padding = '40px'; // Más padding para que no se vea tan apretado
    } else {
      modal.style.minWidth = '300px';
      modal.style.maxWidth = '600px';
    }

    // Header del Modal (Título + Icono Cerrar)
    const header = document.createElement('div');
    header.style.display = 'flex';
    header.style.justifyContent = 'space-between';
    header.style.alignItems = 'center';
    header.style.marginBottom = '10px';

    const titleElement = document.createElement('h3');
    titleElement.textContent = `${icon} ${title}`;
    header.appendChild(titleElement);

    const closeBtn = document.createElement('button');
    closeBtn.textContent = '❌'; // Icono de cerrar
    closeBtn.style.background = 'none';
    closeBtn.style.border = 'none';
    closeBtn.style.fontSize = '18px';
    closeBtn.style.cursor = 'pointer';
    closeBtn.style.padding = '5px';
    closeBtn.addEventListener('click', () => {
      // Si es el primer modal, solo cerramos este
      if (modalNumber === 1) {
        closeAllModals(modalId); // Cerrar solo este modal
      } else {
        // Si es otro modal, cerrar este y el anterior
        closeParentModal(modalId);
      }
    });

    header.appendChild(closeBtn);

    // Cuerpo del modal (Mensaje + Botón para abrir siguiente modal)
    const body = document.createElement('div');
    body.style.marginBottom = '20px';

    const msg = document.createElement('p');
    msg.textContent = message;

    body.appendChild(msg);

    // Agregar el número de modal y el ID de página al cuerpo del modal
    const modalInfo = document.createElement('p');
    modalInfo.textContent = `Modal #${modalNumber} | ID de Página: ${pageId}`;
    body.appendChild(modalInfo);

    // Botón para abrir siguiente modal
    const openNextModalBtn = document.createElement('button');
    openNextModalBtn.textContent = 'Abrir siguiente modal';
    openNextModalBtn.style.padding = '5px 10px';
    openNextModalBtn.style.backgroundColor = '#2196F3';
    openNextModalBtn.style.color = 'white';
    openNextModalBtn.style.border = 'none';
    openNextModalBtn.style.borderRadius = '5px';
    openNextModalBtn.style.cursor = 'pointer';

    openNextModalBtn.addEventListener('click', () => {
      if (onOpenNextModal) onOpenNextModal(); // Ejecutar la función para abrir el siguiente modal
    });

    body.appendChild(openNextModalBtn);

    // Acciones (Botones Confirmar y Cancelar) en la parte inferior
    const actions = document.createElement('div');
    actions.style.display = 'flex';
    actions.style.justifyContent = 'flex-end';
    actions.style.gap = '10px';

    const confirmBtn = document.createElement('button');
    confirmBtn.textContent = confirmText;
    confirmBtn.style.padding = '5px 10px';
    confirmBtn.style.backgroundColor = '#4CAF50';
    confirmBtn.style.color = 'white';
    confirmBtn.style.border = 'none';
    confirmBtn.style.borderRadius = '5px';
    confirmBtn.style.cursor = 'pointer';

    const cancelBtn = document.createElement('button');
    cancelBtn.textContent = cancelText;
    cancelBtn.style.padding = '5px 10px';
    cancelBtn.style.backgroundColor = '#f44336';
    cancelBtn.style.color = 'white';
    cancelBtn.style.border = 'none';
    cancelBtn.style.borderRadius = '5px';
    cancelBtn.style.cursor = 'pointer';

    cancelBtn.addEventListener('click', () => {
      closeParentModal(modalId); // Cerrar este y el anterior
    });

    confirmBtn.addEventListener('click', () => {
      closeAllModals(); // Cerrar todos los modales desde el último abierto
    });

    actions.appendChild(cancelBtn);
    actions.appendChild(confirmBtn);

    // Agregar todo al modal
    modal.appendChild(header);
    modal.appendChild(body);
    modal.appendChild(actions);
    overlay.appendChild(modal);
    document.body.appendChild(overlay);

    // Guardamos el modal en la pila de modales abiertos
    openModals.push({
      modalId,
      overlay,
      modal,
      modalNumber,
      parentModalId,
    });

    // Guardamos el modal en localStorage con su jerarquía
    saveModalToLocalStorage({
      modalId,
      title,
      pageId,
      modalNumber,
      parentModalId,
    });
  }

  // Función para cerrar todos los modales desde el último abierto
  function closeAllModals() {
    // Cerrar modales en orden inverso, desde el último modal hasta el primero
    for (let i = openModals.length - 1; i >= 0; i--) {
      const { overlay, modal, modalId } = openModals[i];

      // Eliminar modal de localStorage
      removeModalFromLocalStorage(modalId);

      // Eliminar el modal del DOM
      document.body.removeChild(overlay);

      // Eliminar el modal de la pila de modales
      openModals.splice(i, 1);
    }
  }

  // Función para cerrar el modal actual y su modal padre (si existe)
  function closeParentModal(modalId) {
    const modalIndex = openModals.findIndex(
      (modal) => modal.modalId === modalId
    );

    if (modalIndex !== -1) {
      // Cerrar el modal actual
      const { overlay, modal } = openModals[modalIndex];

      // Eliminar modal de localStorage
      removeModalFromLocalStorage(modalId);

      // Eliminar el modal del DOM
      document.body.removeChild(overlay);

      // Eliminar el modal de la pila de modales
      openModals.splice(modalIndex, 1);

      // Si el modal tiene un padre, cerramos el modal padre también
      const parentModalId = openModals[modalIndex]?.parentModalId;
      if (parentModalId) {
        closeParentModal(parentModalId); // Recursivamente cerrar el modal padre
      }
    }
  }

  // Función para guardar un modal en localStorage
  function saveModalToLocalStorage(modalData) {
    const modals = JSON.parse(localStorage.getItem('modals')) || [];
    modals.push(modalData);
    localStorage.setItem('modals', JSON.stringify(modals));
  }

  // Función para eliminar un modal de localStorage
  function removeModalFromLocalStorage(modalId) {
    const modals = JSON.parse(localStorage.getItem('modals')) || [];
    const updatedModals = modals.filter((modal) => modal.modalId !== modalId);
    localStorage.setItem('modals', JSON.stringify(updatedModals));
  }

  // Abrir modal principal al hacer click en el botón
  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('open-main-modal').addEventListener('click', () => {
      renderModal({
        title: 'Modal Principal',
        message: '¿Quieres abrir el segundo modal dentro de este?',
        icon: '📦',
        confirmText: 'Confirmar',
        cancelText: 'Cancelar',
        isFullscreen: true, // Primer modal fullscreen
        pageId: 'page_1', // Identificador único
        modalNumber: 1, // Primer modal
        parentModalId: null, // No tiene modal padre
        onConfirm: () => {
          console.log('Confirmado el modal principal');
        },
        onOpenNextModal: () => {
          renderModal({
            title: 'Segundo Modal',
            message: '¿Quieres abrir el tercer modal dentro de este?',
            icon: '🪜',
            confirmText: 'Confirmar',
            cancelText: 'Cancelar',
            pageId: 'page_2',
            modalNumber: 2, // Segundo modal
            parentModalId: 'modal-1', // Modal principal es el padre
            onConfirm: () => {
              console.log('Confirmado el segundo modal');
            },
            onOpenNextModal: () => {
              renderModal({
                title: 'Tercer Modal',
                message: 'Ya estás en el fondo 🤯',
                icon: '🚨',
                confirmText: 'Confirmar',
                cancelText: 'Cancelar',
                pageId: 'page_3',
                modalNumber: 3, // Tercer modal
                parentModalId: 'modal-2', // Segundo modal es el padre
                onConfirm: () => {
                  alert('🚀 ¡Saliste del laberinto!');
                },
                isFullscreen: false, // El tercer modal no será fullscreen
              });
            },
          });
        },
      });
    });
  });
</script>

{% endblock %}
