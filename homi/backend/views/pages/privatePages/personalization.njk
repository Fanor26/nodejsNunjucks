{% extends "index.njk" %} {% block content %}
<h1 style="color: aliceblue">Simulador de Dispositivos</h1>

<!-- Formulario para ingresar el enlace -->

<div
  class="container-device"
  id="device-container"
>
  <div style="margin: 10px; text-align: center">
    <label
      for="urlInput"
      style="font-size: 16px; font-weight: bold"
      >Ingresa el enlace a visualizar en los dispositivos:</label
    ><br />
    <input
      type="url"
      id="urlInput"
      placeholder="Introduzca la url"
      value="https://7000-fanor19481956-nunjucks-yd5ln6v2xwe.ws-us118.gitpod.io/contact"
      style="padding: 10px; width: 300px; margin-top: 10px"
    />
    <button
      onclick="loadDevices()"
      style="padding: 10px 15px; margin-left: 10px; font-size: 16px"
    >
      Comenzar
    </button>
  </div>
  <!-- Los dispositivos se cargarán aquí mediante JS -->
</div>

<!-- Script para cargar contenido dinámico y generar dispositivos -->
<script>
  // Lista de dispositivos
  const devices = [
    {
      type: 'iPhone',
      orientation: 'portrait',
      dimensions: { width: 375, height: 667 },
      name: 'iPhone 6/7/8 - Portrait',
      description: 'iPhone eXpensive Portrait · width: 375px · height: 667px',
    },
    {
      type: 'iPhone',
      orientation: 'landscape',
      dimensions: { width: 667, height: 375 },
      name: 'iPhone 6/7/8 - Landscape',
      description: 'iPhone eXpensive Landscape · width: 667px · height: 375px',
    },
    {
      type: 'Android',
      orientation: 'portrait',
      dimensions: { width: 412, height: 732 },
      name: 'Android Pixel - Portrait',
      description: 'Android Pixel Portrait · width: 412px · height: 732px',
    },
    {
      type: 'Android',
      orientation: 'landscape',
      dimensions: { width: 684, height: 412 },
      name: 'Android Pixel - Landscape',
      description: 'Android Pixel Landscape · width: 684px · height: 412px',
    },
    {
      type: 'iPad',
      orientation: 'portrait',
      dimensions: { width: 768, height: 1024 },
      name: 'iPad - Portrait',
      description: 'iPad Portrait · width: 768px · height: 1024px',
    },
    {
      type: 'iPad',
      orientation: 'landscape',
      dimensions: { width: 1024, height: 768 },
      name: 'iPad - Landscape',
      description: 'iPad Landscape · width: 1024px · height: 768px',
    },
  ];

  // Función para generar los dispositivos
  function generateDevices() {
    const container = document.getElementById('device-container');
    devices.forEach((device) => {
      const deviceWrapper = document.createElement('div');
      deviceWrapper.classList.add('device-wrapper');

      const deviceElement = document.createElement('div');
      deviceElement.classList.add(
        'device',
        `${device.type.toLowerCase()}-${device.orientation}`
      );

      const screenElement = document.createElement('div');
      screenElement.classList.add('screen');

      const screenContent = document.createElement('div');
      screenContent.classList.add('screen-content');
      screenContent.id = `${device.type.toLowerCase()}-${
        device.orientation
      }-content`;
      screenContent.innerHTML = `<p>Tu contenido aquí</p>`; // Mensaje por defecto

      screenElement.appendChild(screenContent);
      deviceElement.appendChild(screenElement);

      const deviceName = document.createElement('p');
      deviceName.classList.add('device-name');
      deviceName.innerText = device.name;

      const deviceDescription = document.createElement('p');
      deviceDescription.classList.add('device-description');
      deviceDescription.innerText = device.description;

      deviceWrapper.appendChild(deviceElement);
      deviceWrapper.appendChild(deviceName);
      deviceWrapper.appendChild(deviceDescription);

      container.appendChild(deviceWrapper);
    });
  }

  // Función para cargar el contenido en los dispositivos
  function loadDevices() {
    const url = document.getElementById('urlInput').value; // Obtener el enlace ingresado
    if (url) {
      devices.forEach((device) => {
        const deviceId = `${device.type.toLowerCase()}-${
          device.orientation
        }-content`;
        const iframe = `<iframe src="${url}" title="${device.name}"></iframe>`;
        loadContent(deviceId, iframe);
      });
    } else {
      alert('Por favor, ingresa un enlace válido.');
    }
  }

  // Función para cargar contenido dinámico en un dispositivo
  function loadContent(deviceId, content) {
    const device = document.getElementById(deviceId);
    device.innerHTML = content;
  }

  // Inicializamos la generación de los dispositivos
  generateDevices();
</script>

{% endblock %}
